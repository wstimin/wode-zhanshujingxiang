{
  "log": { "level": "info", "timestamp": true },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "127.0.0.1",
      "listen_port": 8081,
      "users": [ { "uuid": "$$UUID$$", "flow": "" } ],
      "transport": { "type": "ws", "path": "$$WSPATH$$" }
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "block", "tag": "block" }
  ]
}
